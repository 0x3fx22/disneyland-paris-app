# Disneyland Paris MyDisney Account Credentials
DISNEY_EMAIL=your_email@domain.com
DISNEY_PASSWORD=YourPassword123!

# Session Management
DISNEY_SESSION_FILE=authenticated_session.json
DISNEY_BROWSER_PROFILE=.disney_browser_profile

# Optional: Automated Email OTP Ingestion via IMAP (e.g. Proton Mail Bridge or dedicated inbox)
# If left empty, auth_manager will fallback to interactive OTP prompt when 2FA is triggered
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
